<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PanelVersion>0.3.0</PanelVersion>
    <Version>$(PanelVersion)</Version>
    <NeutralLanguage>ru-RU</NeutralLanguage>
  </PropertyGroup>

  <!-- Известные уязвимости зависимостей, включая транзитивные, валят restore: NU1901–NU1904
       становятся ошибками через TreatWarningsAsErrors. У привилегированного демона есть
       сторонняя зависимость (Microsoft.Data.Sqlite), и уязвимая транзитивная версия уже
       попадалась (findings §16). Недоступный источник сведений (NU1900, сборка без сети)
       остаётся предупреждением; новые уязвимости без правок ловит .github/workflows/audit.yml. -->
  <PropertyGroup>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1900</WarningsNotAsErrors>
  </PropertyGroup>

  <!-- Панель общается с systemd, /proc и Unix-сокетами: эти вызовы допустимы только
       в привилегированной сборке, поэтому предупреждения о платформе гасятся точечно,
       а не глобально. См. архитектурные тесты. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Panel.Agent'">
    <SupportedOSPlatformVersion>1.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!-- Панель и демон работают постоянно рядом с игровым сервером, которому нужна память.
       Microsoft.NET.Sdk.Web по умолчанию включает серверный сборщик: куча на каждое ядро и
       редкие сборки, и процесс с горсткой запросов держит сотни мегабайт. Рабочей станции без
       фонового потока сборки хватает: запросов мало, пауза сборки небольшой кучи короче
       миллисекунды. ConserveMemory сжимает кучу больших объектов вместо того, чтобы расти. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Panel.Web' Or '$(MSBuildProjectName)' == 'Panel.Agent'">
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Panel.Web' Or '$(MSBuildProjectName)' == 'Panel.Agent'">
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

  <!-- Значок трёх поставляемых программ: .exe на Windows (Проводник, диспетчер задач, ярлыки).
       На Linux ресурс Win32 в сборке ничего не меняет. Источник — scripts/icons.ps1. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Panel.Web' Or '$(MSBuildProjectName)' == 'Panel.Agent' Or '$(MSBuildProjectName)' == 'Panel.Cli'">
    <ApplicationIcon>$(MSBuildThisFileDirectory)assets\vs-panel.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
