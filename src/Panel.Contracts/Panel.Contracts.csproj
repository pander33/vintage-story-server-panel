<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Panel.SharedKernel\Panel.SharedKernel.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Переводы сообщений: русский шаблон Phrase → английский текст. Русский — язык шаблонов,
       поэтому каталог один. Здесь, а не в панели: фразы показывает и установщик. -->
  <ItemGroup>
    <None Remove="Resources\**" />
    <EmbeddedResource Include="Resources\phrases-*.json" LogicalName="Panel.Contracts.Resources.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
